# ---------- Northflank miner ----------
KNX_API_KEY=knx_sk_replace_me
KNX_NODE_URL=https://knxcoin.vercel.app
KNX_MINER_SESSION_ID=replace_with_a_unique_uuid
KNX_WORKERS=1
KNX_STATUS_POLL_SECONDS=4
KNX_TEMPLATE_MIN_INTERVAL_SECONDS=12
KNX_HTTP_TIMEOUT_SECONDS=15
KNX_LOG_INTERVAL_SECONDS=2
MINER_AUTOSTART=1
MINER_CONTROL_TOKEN=replace_with_a_long_random_secret
PORT=8080

# ---------- Vercel frontend ----------
# Example: https://your-miner-service--project--account.code.run
MINER_BACKEND_URL=https://replace-with-your-northflank-domain
# Must exactly match the Northflank MINER_CONTROL_TOKEN.
MINER_CONTROL_TOKEN=replace_with_the_same_long_random_secret
