# Required: create/copy this from the KNXCoin mining page.
KNX_API_KEY=knx_sk_replace_me

# KNXCoin node. Normally leave this unchanged.
KNX_NODE_URL=https://knxcoin.vercel.app

# Northflank/container health server.
PORT=8080

# Detect when somebody else mines the current block and switch jobs quickly.
KNX_STATUS_POLL_SECONDS=2

# Set this to the number of vCPUs you actually allocate to the Northflank service.
# Keep it at 1 on a 1-vCPU plan.
KNX_WORKERS=1

KNX_HTTP_TIMEOUT_SECONDS=20
KNX_LOG_INTERVAL_SECONDS=5
