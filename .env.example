# ---------- Northflank miner ----------
KNX_API_KEY=knx_sk_replace_me
KNX_NODE_URL=https://knxcoin.vercel.app
KNX_MINER_SESSION_ID=replace_with_a_unique_uuid
KNX_WORKERS=1
KNX_STATUS_POLL_SECONDS=4
KNX_TEMPLATE_MIN_INTERVAL_SECONDS=12
KNX_HTTP_TIMEOUT_SECONDS=15
KNX_LOG_INTERVAL_SECONDS=2
MINER_CONTROL_TOKEN=replace_with_a_long_random_secret
PORT=8080

# ---------- Vercel frontend: Miner 1 ----------
MINER_BACKEND_URL_1=https://replace-with-miner-1-northflank-domain
MINER_CONTROL_TOKEN_1=replace_with_miner_1_control_secret

# ---------- Vercel frontend: Miner 2 ----------
MINER_BACKEND_URL_2=https://replace-with-miner-2-northflank-domain
MINER_CONTROL_TOKEN_2=replace_with_miner_2_control_secret
